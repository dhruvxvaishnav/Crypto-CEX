{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP RPS",
      "description": "Requests per second by route (PRD §19.2 http_requests_total)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
          "expr": "sum(rate(aether_http_requests_total[1m])) by (route)",
          "instant": false,
          "legendFormat": "{{ route }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Latency P50 / P95 / P99",
      "description": "Request duration quantiles (PRD §19.2 http_request_duration_seconds)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineInterpolation": "linear",
            "showPoints": "never"
          },
          "unit": "s"
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(aether_http_request_duration_seconds_bucket[5m])) by (le))",
          "instant": false,
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(aether_http_request_duration_seconds_bucket[5m])) by (le))",
          "instant": false,
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(aether_http_request_duration_seconds_bucket[5m])) by (le))",
          "instant": false,
          "legendFormat": "P99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Engine Orders / sec",
      "description": "Matching engine throughput (PRD §19.2 engine_orders_processed_total)",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "ops"
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
          "expr": "sum(rate(aether_engine_orders_processed_total[1m]))",
          "instant": false,
          "legendFormat": "orders/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Settlement Lag (seq)",
      "description": "Engine sequence minus last settlement processed sequence — 0 is healthy (PRD §19.2 settlement_lag_seq)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
          "expr": "aether_settlement_lag_seq",
          "instant": false,
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active WebSocket Connections",
      "description": "Live WS subscriptions (PRD §19.2 ws_connections)",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "short"
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
          "expr": "aether_ws_connections",
          "instant": false,
          "legendFormat": "connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB Pool In Use",
      "description": "Active Postgres connections across services (PRD §19.2 db_pool_in_use)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "short"
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
          "expr": "aether_db_pool_in_use",
          "instant": false,
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error Rate (5xx / min)",
      "description": "Server-error rate (PRD §19.2 http_requests_total filtered by status 5xx)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": { "lineInterpolation": "linear", "showPoints": "never" },
          "unit": "short"
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aether-prometheus" },
          "expr": "sum(rate(aether_http_requests_total{status=~\"5..\"}[1m])) * 60",
          "instant": false,
          "legendFormat": "errors/min",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["aether", "crypto-cex"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Aether Overview",
  "uid": "aether-overview",
  "version": 2
}
